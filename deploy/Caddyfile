# Runs inside the app container next to the API and realtime server (see deploy/start.mjs).
# SITE_ADDRESS is DOMAIN by default, so Caddy gets and renews HTTPS certificates automatically.
{$SITE_ADDRESS} {
	encode zstd gzip

	handle /api/* {
		reverse_proxy 127.0.0.1:{$API_PORT}
	}

	handle /ws {
		reverse_proxy 127.0.0.1:{$REALTIME_PORT}
	}

	handle {
		root * /srv
		@immutable path /_app/immutable/*
		header @immutable Cache-Control "public, max-age=31536000, immutable"
		header /fonts/* Cache-Control "public, max-age=2592000"
		header {
			X-Content-Type-Options nosniff
			Referrer-Policy strict-origin-when-cross-origin
			X-Frame-Options DENY
		}
		try_files {path} /200.html
		file_server
	}
}
