# Runs inside the app container next to the API and realtime server (see deploy/start.mjs).
# SITE_ADDRESS is DOMAIN by default, so Caddy gets and renews HTTPS certificates automatically.

{
	servers {
		# Keep X-Forwarded-For from a proxy in front of the container (cloudflared, nginx, ...),
		# otherwise every request looks like it came from that proxy. The API only believes the
		# header past its own hop when TRUST_PROXY allows it (see .env.production.example).
		trusted_proxies static private_ranges
	}
}
{$SITE_ADDRESS} {
	encode zstd gzip

	handle /api/* {
		reverse_proxy 127.0.0.1:{$API_PORT}
	}

	handle /ws {
		reverse_proxy 127.0.0.1:{$REALTIME_PORT}
	}

	handle {
		root * /srv
		@immutable path /_app/immutable/*
		header @immutable Cache-Control "public, max-age=31536000, immutable"
		header /fonts/* Cache-Control "public, max-age=2592000"
		# everything else (200.html, _app/version.json, sounds, ...) is revalidated on every load,
		# otherwise browsers cache the html heuristically and keep booting a stale build after a deploy
		@revalidate not path /_app/immutable/* /fonts/*
		header @revalidate Cache-Control "no-cache"
		header {
			X-Content-Type-Options nosniff
			Referrer-Policy strict-origin-when-cross-origin
			X-Frame-Options DENY
		}
		try_files {path} /200.html
		file_server
	}
}
