{
  "name": "mt-ranked",
  "version": "0.1.0",
  "private": true,
  "license": "GPL-3.0",
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "services:up": "bash scripts/services.sh up",
    "services:down": "bash scripts/services.sh down",
    "db:migrate": "pnpm --filter @mtr/db migrate",
    "db:seed": "pnpm --filter @mtr/db seed",
    "season:rollover": "pnpm --filter @mtr/db season-rollover",
    "make-moderator": "pnpm --filter @mtr/db make-moderator",
    "dev": "node scripts/check-services.mjs && turbo run dev",
    "build": "turbo run build",
    "bot": "pnpm --filter @mtr/realtime bot",
    "check": "turbo run check",
    "test": "turbo run test",
    "start": "turbo run start",
    "lint": "prettier --check . && oxlint --deny-warnings",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "oxlint": "1.89.0",
    "prettier": "3.9.10",
    "prettier-plugin-svelte": "4.1.1",
    "turbo": "2.11.7",
    "typescript": "6.0.3"
  }
}
