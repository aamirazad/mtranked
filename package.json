{
  "name": "mt-ranked",
  "version": "0.1.0",
  "private": true,
  "license": "GPL-3.0",
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "db:migrate": "pnpm --filter @mtr/worker db:migrate",
    "build": "turbo run build",
    "deploy": "turbo run build --filter=@mtr/worker && pnpm --filter @mtr/worker exec cf deploy --prebuilt",
    "bot": "pnpm --filter @mtr/worker bot",
    "check": "turbo run check",
    "test": "turbo run test"
  },
  "devDependencies": {
    "turbo": "2.11.7",
    "typescript": "6.0.3"
  }
}
