{
  "$schema": "https://turbo.build/schema.json",
  "agentGuidance": false,
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**",
        "build/**",
        ".svelte-kit/**",
        ".cloudflare/output/**"
      ],
      "passThroughEnv": [
        "SENTRY_AUTH_TOKEN"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "check": {},
    "test": {},
    "@mtr/worker#build": {
      "dependsOn": [
        "^build",
        "@mtr/frontend#build"
      ],
      "outputs": [
        ".cloudflare/output/**"
      ]
    },
    "@mtr/worker#check": {
      "outputs": [
        ".cloudflare/types/**"
      ]
    }
  }
}
