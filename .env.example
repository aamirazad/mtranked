# Copy to .env (root). Values below match docker-compose.dev.yml.
NODE_ENV=development
DATABASE_URL=postgres://mtr:mtr@localhost:5433/mtr
REDIS_URL=redis://localhost:6380

# Public URL of the site (used in emails, invite links, Stripe redirects)
APP_URL=http://localhost:5173
API_PORT=4001
REALTIME_PORT=4002

# Email (SMTP). Mailpit catches mail locally: open http://localhost:8025
SMTP_URL=smtp://localhost:1025
MAIL_FROM="MT Ranked <no-reply@localhost>"

# Ranked eligibility: minimum account age in hours (plan: 24). 0 is handy in dev.
RANKED_MIN_ACCOUNT_AGE_HOURS=0

# Supporter sales. Off: new accounts quietly get supporter for life and the site
# never mentions a supporter tier. On: supporter is sold to new signups.
SUPPORTER_SALES=false

# Stripe (optional locally). Without these, subscriptions use a dev toggle.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=

# Source code link shown in the footer (GPL-3.0 requires offering source)
PUBLIC_SOURCE_URL=https://github.com/your-name/mt-ranked

# Contact address shown in the terms of service and privacy policy
PUBLIC_CONTACT_EMAIL=you@example.com
