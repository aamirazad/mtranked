# Copy to .env (root). Only the frontend reads this: public settings baked in at build time.
# In CI they come from repository variables instead (see README).

# Source code link shown in the footer (GPL-3.0 requires offering source)
PUBLIC_SOURCE_URL=https://github.com/aamirazad/mtranked

# Contact address shown in the terms of service and privacy policy
PUBLIC_CONTACT_EMAIL=you@example.com

# Sentry DSN of the browser project, optional
PUBLIC_SENTRY_DSN=
