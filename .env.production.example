# Copy to .env.production on the server and fill in.
DOMAIN=mtranked.example.com
APP_URL=https://mtranked.example.com
POSTGRES_PASSWORD=change-me-to-a-long-random-string
# Leave DATABASE_URL / REDIS_URL unset to use the bundled containers,
# or point them at managed services (Neon, Supabase, Upstash, ...).
# DATABASE_URL=postgres://user:pass@host:5432/db?sslmode=require
# REDIS_URL=rediss://default:pass@host:6379

# Transactional email over SMTP (Resend, Postmark, SES all offer SMTP)
SMTP_URL=smtps://resend:re_xxx@smtp.resend.com:465
MAIL_FROM="MT Ranked <no-reply@mtranked.example.com>"

RANKED_MIN_ACCOUNT_AGE_HOURS=24

# Stripe (optional; supporters toggle stays disabled without it)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=
STRIPE_AUTOMATIC_TAX=false

# Public link to your fork's source (GPL-3.0 requires offering it)
PUBLIC_SOURCE_URL=https://github.com/your-name/mt-ranked
