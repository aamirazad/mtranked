# Copy to .env.production on the server and fill in.
# App image tag from ghcr.io/aamirazad/mtranked: main (every commit on main),
# latest (newest release), or a pinned release like 1.2.3
MTR_TAG=main
DOMAIN=mtranked.example.com
APP_URL=https://mtranked.example.com
# Caddy listens on DOMAIN with automatic HTTPS. Behind another reverse proxy, set :80 for plain HTTP.
# SITE_ADDRESS=:80
# Behind a Cloudflare Tunnel or another reverse proxy, also trust the Docker network hop so the
# API sees each visitor's real IP (rate limits, sessions, bans). Only set this when the app port
# is reachable through that proxy alone (docker-compose.tunnel.yml binds it to 127.0.0.1).
# TRUST_PROXY=loopback,uniquelocal
# Host port for docker-compose.tunnel.yml (default 8085)
# APP_PORT=8085
POSTGRES_PASSWORD=change-me-to-a-long-random-string
# Leave DATABASE_URL / REDIS_URL unset to use the bundled containers,
# or point them at managed services (Neon, Supabase, Upstash, ...).
# DATABASE_URL=postgres://user:pass@host:5432/db?sslmode=require
# REDIS_URL=rediss://default:pass@host:6379

# Postgres backups (the `backup` service; see "Backups" in README.md)
# Host directory the daily dumps are written to
BACKUP_DIR=./backups
# Days of dumps to keep; older ones are deleted after each successful backup
BACKUP_KEEP_DAYS=14

# Transactional email over SMTP (Resend, Postmark, SES all offer SMTP)
SMTP_URL=smtps://resend:re_xxx@smtp.resend.com:465
MAIL_FROM="MT Ranked <no-reply@mtranked.example.com>"

RANKED_MIN_ACCOUNT_AGE_HOURS=24

# Supporter sales. Off: new accounts quietly get supporter for life and the site
# never mentions a supporter tier. On: supporter is sold to new signups (needs Stripe below).
SUPPORTER_SALES=false

# Stripe (optional; supporters toggle stays disabled without it)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=
STRIPE_AUTOMATIC_TAX=false

# Public build settings below are baked into the frontend when the image is built:
# for GHCR images set them as GitHub repository variables instead (see README).

# Public link to your fork's source (GPL-3.0 requires offering it)
PUBLIC_SOURCE_URL=https://github.com/your-name/mt-ranked

# Contact address shown in the terms of service and privacy policy
PUBLIC_CONTACT_EMAIL=support@mtranked.example.com

# Sentry error reporting (optional; each is disabled when empty)
# DSN of the Node.js project (mtranked-server), used by the api and realtime servers
SENTRY_DSN=
# DSN of the browser project (mtranked), baked into the frontend at build time
PUBLIC_SENTRY_DSN=
# Auth token (scope project:releases) so the frontend build can upload source maps
SENTRY_AUTH_TOKEN=
